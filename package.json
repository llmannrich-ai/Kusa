{
  "name": "kusa",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w @kusa/client",
    "dev:server": "npm run dev -w @kusa/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
